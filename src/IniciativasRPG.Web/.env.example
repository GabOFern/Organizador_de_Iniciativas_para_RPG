# Local direto na API:
# VITE_API_BASE_URL=http://localhost:5111
# VITE_HUB_URL=http://localhost:5111/hubs/battle

# Via proxy do Vite (recomendado em local e com Cloudflare Quick Tunnel /
# iniciar.bat /publico na :5173 — ver docs/CONFIGURACAO-E-DEPLOY.md):
VITE_API_BASE_URL=
VITE_HUB_URL=/hubs/battle

# Cloudflare Tunnel com front e API em hostnames separados:
# VITE_API_BASE_URL=https://api.rpg.seudominio.com
# VITE_HUB_URL=https://api.rpg.seudominio.com/hubs/battle
